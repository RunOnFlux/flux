FROM ubuntu:22.04

RUN apt-get update && apt-get install -y sudo ufw curl ca-certificates make cron xz-utils git

# CI's Node (.github/workflows/nodejs.yml), the oldest the fleet runs
ARG NODE_VERSION=24.14.1
RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz | \
tar -xJ -C /usr/local --strip-components=1

RUN adduser --disabled-password \
--gecos '' fluxtesting

RUN usermod -aG sudo fluxtesting

COPY entrypoint.sh /home/fluxtesting/

RUN echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

USER fluxtesting

# test dir must be called flux
WORKDIR /home/fluxtesting/flux

ENTRYPOINT ["/home/fluxtesting/entrypoint.sh"]

# this can be overridden on command line for specific tests
CMD ["tests/unit/**/*.test.js"]
