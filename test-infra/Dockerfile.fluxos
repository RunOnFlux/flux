FROM ubuntu:26.04 AS base

# Where the base packages come from. Canonical by default, so an unset build changes
# nothing; a box that cannot reach archive.ubuntu.com passes another mirror:
#
#   UBUNTU_MIRROR=http://mirrors.edge.kernel.org/ubuntu ./test-infra/build-images.sh
#
# This exists because a whole gate is one unreachable host away from impossible. On
# 2026-09-11 both harness boxes could fetch github, npm and download.docker.com in under
# a quarter-second each while every Canonical mirror refused TCP - ICMP to the same
# address answered, at a second per round trip - and the node image cannot be built
# without the archive. The three apt layers are normally cache hits, so the outage only
# surfaced because `ubuntu:26.04` is a ROLLING tag: a fresh pull changed the base digest
# and turned every cached layer into a live fetch.
#
# Security is redirected with it, and can be pointed somewhere else again: leaving it on
# Canonical would stall the same build for the same reason, since apt-get update fetches
# every configured source whether or not the install needs it.
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
ARG UBUNTU_SECURITY_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive

# The rewrite rides along with the first install rather than taking a layer of its own -
# a mirror is not a step, it is where this layer's bytes come from. 26.04 ships deb822
# (`/etc/apt/sources.list.d/ubuntu.sources`), with archive and security as separate
# stanzas, so both URIs are replaced and the trailing slash is normalised so a mirror
# written either way works.
RUN set -eu; \
    sec="${UBUNTU_SECURITY_MIRROR:-$UBUNTU_MIRROR}"; \
    sed -i \
      -e "s|http://archive.ubuntu.com/ubuntu/|${UBUNTU_MIRROR%/}/|g" \
      -e "s|http://security.ubuntu.com/ubuntu/|${sec%/}/|g" \
      /etc/apt/sources.list.d/ubuntu.sources; \
    grep -q '^URIs:' /etc/apt/sources.list.d/ubuntu.sources; \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    sudo \
    ufw \
    mount \
    cron \
    gnupg \
    iproute2 \
    iputils-ping \
    socat \
    iptables \
    conntrack \
    tcpdump \
    e2fsprogs \
    systemd \
    dbus \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# The node's docker: the newest release unless DOCKER_VERSION names one, as apt
# spells it (5:27.5.1-1~ubuntu.24.04~noble), for a run against an older docker.
ARG DOCKER_VERSION=
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "docker-ce${DOCKER_VERSION:+=$DOCKER_VERSION}" "docker-ce-cli${DOCKER_VERSION:+=$DOCKER_VERSION}" containerd.io \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# The packages FluxOS installs on a legacy node, and the repository it installs
# them from.
#
# monitorSystem() returns immediately when FLUXOS_PATH is set, so this path only
# runs on legacy nodes - and there it really installs, over the internet, inside
# every boot. Resolving the closure at build time and serving it to the fleet
# closes that without taking the install path out of the test: a seeded node
# still runs monitorSystem() for real and finds its prerequisites satisfied, and
# a suite that wants the install itself purges them first.
#
# The stage builds on `base`, not on ubuntu directly, because the closure is
# whatever apt resolves against THIS image's package state. Computed against a
# barer image it would name packages the node already has and miss ones it does
# not.
#
# Recommends are deliberately not suppressed. aptRunner passes no
# --no-install-recommends, so a node's own install pulls them - that is where
# shared-mime-info comes from - and a repository built without them would be
# missing packages the node goes on to ask for.
FROM base AS debcache

COPY test-infra/syncthing-debs.sha256 /tmp/syncthing-debs.sha256
COPY test-infra/build-apt-repo.sh /usr/local/bin/build-apt-repo.sh
COPY test-infra/fetch-syncthing-deb.sh /usr/local/bin/fetch-syncthing-deb.sh

# syncthing is the release named here, one of those in test-infra/syncthing-versions
# (build-images.sh passes it): the package syncthing publishes with that release
# on GitHub, the one a node installs, which is built without self-upgrade. The
# fleet's nodes run more than one version and a suite has to be run against each,
# which syncthing's own apt repository cannot serve: it carries only its two
# newest. test-infra/syncthing-debs.sha256 pins each package, so every build of a
# version installs the same file.
ARG SYNCTHING_VERSION
RUN test -n "$SYNCTHING_VERSION" \
    && apt-get update \
    && apt-get install -y --no-install-recommends dpkg-dev apt-utils \
    && rm -rf /var/cache/apt/archives/*.deb \
    && apt-get install -y --download-only chrony netcat-openbsd openssh-server libpam-systemd \
    && chmod +x /usr/local/bin/fetch-syncthing-deb.sh /usr/local/bin/build-apt-repo.sh \
    && /usr/local/bin/fetch-syncthing-deb.sh "$SYNCTHING_VERSION" /var/cache/apt/archives \
    && /usr/local/bin/build-apt-repo.sh /opt/flux-apt-repo

FROM base

# The repository travels in the image because the stub that serves it to the
# fleet copies it from here: what a node installs at runtime is then the same
# file it was seeded with, not a second download that can differ.
COPY --from=debcache /opt/flux-apt-repo /opt/flux-apt-repo

# Every source that reaches the internet goes, including the two this Dockerfile
# added for its own build - docker's and nodesource's outlive the layer that
# needed them, so any later apt-get update refreshes them, which is egress that
# exists in no product source file. Removing the directory wholesale rather than
# naming files means a source added later cannot be missed here.
#
# The base packages are served from the image over file:// because FluxOS never
# writes this source and serving it over HTTP would cover nothing. The one
# source FluxOS does write - syncthing's - is pointed at the stub over HTTP by
# config, so the keyring fetch, the source write and apt's HTTP transport are
# all exercised as they are on a node.
#
# Seeded here, so a normal fleet boots into the steady state. openssh-server is
# served but never seeded: a legacy node installs it itself when maintenance
# access is configured, and that install is part of what the suite exercises.
# libpam-systemd is served but never seeded either: a node without it keeps an
# ssh session in the sshd unit's cgroup, a node with it gives the session its
# own logind scope, and a suite installs it where it needs the second shape.
RUN rm -f /etc/apt/sources.list.d/* /etc/apt/sources.list \
    && cp /opt/flux-apt-repo/keyring.gpg /usr/share/keyrings/flux-e2e-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/flux-e2e-archive-keyring.gpg] file:///opt/flux-apt-repo ubuntu main" \
         > /etc/apt/sources.list.d/flux-e2e.list \
    && apt-get update \
    && apt-get install -y chrony syncthing netcat-openbsd \
    && rm -rf /var/cache/apt/archives/*.deb \
    && syncthing --version

# The package index stays. A node has one, and upgradePackage refreshes the cache
# without forcing - cacheUpdateTime falls back to the mtime of /var/lib/apt/lists,
# which on a freshly built image is minutes old, so the refresh is skipped as
# recent. Emptied, the index is then both absent and apparently current, and every
# install fails with `Unable to locate package` before reaching the network at all.

# The account a node runs FluxOS under when it is not root.
#
# FluxOS is root on Arcane and the user the operator installed it as everywhere
# else, and the difference decides what it can read: syncthing is spawned with
# sudo either way, so on an unprivileged node the index describes files the node
# process itself may be refused - a container owns its mount point and sets the
# mode. sudo without a password is what that node does every privileged thing
# with, and membership of docker is how it reaches the daemon; both are the
# unprivileged install's own arrangement, not a harness convenience.
#
# The container stays root - it has loop devices to make, cgroups to delegate and
# a dockerd to supervise, which is the host's work on a real node. Only the
# FluxOS process drops, and only where a fleet asks for it.
#
# The image's own uid 1000 goes so this account can hold it: an app container's
# uid is what has to differ from FluxOS's, and 1000 is the one an operator gets.
RUN set -eu; \
    if id -u ubuntu >/dev/null 2>&1; then userdel -r ubuntu 2>/dev/null || userdel ubuntu; fi; \
    groupadd -g 1000 fluxuser; \
    useradd -u 1000 -g 1000 -G docker -m -s /bin/bash fluxuser; \
    ln -s /flux /home/fluxuser/zelflux; \
    printf 'fluxuser ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/fluxuser; \
    chmod 0440 /etc/sudoers.d/fluxuser; \
    sudo -n -u fluxuser sudo -n id -u | grep -qx 0

WORKDIR /flux

COPY package.json ./
RUN npm install --production \
    && cp package-lock.json /tmp/image-package-lock.json

# pm2, for a legacy node started the way the multitool starts one, at the
# version in test-infra/pm2-version: the multitool installs pm2@latest, and a
# suite measuring its stop must know which pm2 it measured. The file is in the
# build context, so changing it marks the image stale.
#
# pm2 reports to version.pm2.io the first time it runs in a pm2 home that has
# no `touch` marker, and daily from its daemon unless PM2_DISABLE_VERSION_CHECK
# is set. The fleet has no route out, so both are off, for each account that
# runs pm2: root, and fluxuser when FluxOS runs as that user.
ENV PM2_DISABLE_VERSION_CHECK=1
COPY test-infra/pm2-version /tmp/pm2-version
RUN PM2_VERSION="$(tr -d '[:space:]' < /tmp/pm2-version)" \
    && test -n "$PM2_VERSION" && npm install -g "pm2@${PM2_VERSION}" \
    && mkdir -p /root/.pm2 /home/fluxuser/.pm2 \
    && touch /root/.pm2/touch /home/fluxuser/.pm2/touch \
    && chown -R fluxuser:fluxuser /home/fluxuser/.pm2

# The install belongs to the account that runs it, which is what an operator's own
# install looks like and what lets FluxOS write its logs, its config and the TLS
# key it generates at first boot. Carried by the copy rather than a chown of its
# own: on an overlay filesystem a recursive chown copies every file it touches up
# into the container's writable layer, which on this tree is minutes of boot and
# reads as a node that never came up. node_modules keeps root's ownership - it is
# .dockerignore'd here and installed above, and FluxOS only reads it. Root ignores
# all of it, so the image is unchanged for a node that stays root.
COPY --chown=fluxuser:fluxuser . .

COPY --chown=fluxuser:fluxuser test-infra/fixtures/userconfig-template.js /flux/config/userconfig.js

# The lockfile that describes the node_modules installed above. The build context
# may carry another (development does not track one), and a node started by pm2
# runs npm install at every start with no registry to reach: it succeeds only
# when the lockfile and node_modules agree.
RUN cp /tmp/image-package-lock.json /flux/package-lock.json

RUN touch /flux/debug.log /flux/error.log /flux/info.log /flux/warn.log \
    && chown fluxuser:fluxuser /flux /flux/debug.log /flux/error.log /flux/info.log /flux/warn.log \
    && ln -s /flux /root/zelflux

# The numeric id tables an Arcane image carries, where it carries them, from the
# module FluxOS itself writes them with. start-syncthing.sh gives them to the
# syncthing it starts, as Arcane's unit does.
RUN mkdir -p /usr/lib/syncthing \
    && node -e "const t = require('/flux/ZelBack/src/services/utils/numericIdTables'); const fs = require('fs'); \
         const passwd = t.passwdTable(); const group = t.groupTable(); \
         if (t.tablesSha256(passwd, group) !== t.TABLES_SHA256) throw new Error('numeric id tables do not match TABLES_SHA256'); \
         fs.writeFileSync('/usr/lib/syncthing/passwd', passwd); fs.writeFileSync('/usr/lib/syncthing/group', group);"

ENV NODE_CONFIG_DIR=/flux/ZelBack/config

COPY test-infra/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 16126 16127 16128 16129

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "app.js"]
